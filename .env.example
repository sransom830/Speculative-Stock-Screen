# Copy to .env and fill in. Never commit .env.

# --- Alpaca Markets (data/providers/alpaca_provider.py) ---
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# AlpacaMarketDataProvider defaults to paper trading for TradingClient clock/universe.
# Set to false for live trading API (still read-only usage here).
# ALPACA_PAPER=true

# --- Supabase (data/storage + layer1 persistence) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_KEY=your-service-role-key

# Generic logging / app
# LOG_LEVEL=INFO
